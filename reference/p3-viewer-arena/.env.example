# 이 파일을 .env로 복사해서 쓰세요. cargo run이 .env를 자동으로 읽어요.
#   PowerShell: Copy-Item .env.example .env
# .env에는 비밀번호가 들어갈 수 있으니 커밋하지 않아요(.gitignore에 있어요).

# 듣는 주소
#   127.0.0.1 = 이 PC에서만 접속(기본, 안전)
#   0.0.0.0   = 같은 Wi-Fi의 휴대폰도 접속(처음 켤 때 Windows 방화벽에서 "허용"을 눌러야 해요)
HOST=127.0.0.1
PORT=8080

# PostgreSQL 주소. 주석(#)으로 두면 랭킹 없이 게임만 돌아가요(Day 33 전까지는 이대로).
# docker compose up -d db 로 띄운 DB를 쓸 때:
# DATABASE_URL=postgres://arena:arena@127.0.0.1:5432/viewer_arena

# 빌드된 클라이언트 폴더(워크스페이스 폴더 C:\dev\viewer-arena 에서 cargo run 할 때 기준)
STATIC_DIR=client/dist

# 로그 자세함: error, warn, info, debug, trace
RUST_LOG=info

# DB 통합 테스트(cargo test -p server --test leaderboard_db)용 주소. 없으면 그 테스트는 건너뛰어요.
# TEST_DATABASE_URL=postgres://arena:arena@127.0.0.1:5432/viewer_arena_test

# docker compose가 PC 쪽에 여는 포트(이미 쓰는 포트와 겹칠 때만 바꿔요)
# SERVER_PORT=8080
# DB_PORT=5432
