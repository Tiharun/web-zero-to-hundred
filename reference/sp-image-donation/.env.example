# docker compose가 읽는 값입니다. 이 파일을 .env로 복사한 뒤 값을 바꾸세요. (.env는 커밋하지 않아요)
POSTGRES_USER=imagedonation
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=image_donation

# 보낸 사람 IP를 해시할 때 쓰는 비밀 키. 아무도 모르는 긴 무작위 문자열로 바꾸세요.
IP_HASH_KEY=change-me-to-a-long-random-string

# 치지직 앱 (선택: 개발자 센터에서 발급. 비워 두면 테스트 모드만 동작)
CHZZK_CLIENT_ID=
CHZZK_CLIENT_SECRET=
CHZZK_REDIRECT_URI=http://localhost:8080/api/chzzk/callback

# 이미지 라이브러리(ImageSharp 4.x)는 Release 빌드에 Six Labors 라이선스 키가 필요해요 (README "이미지 라이브러리 라이선스").
# 내 PC에서 공부할 때는 Debug(키 없이 경고만), 공개 배포할 때는 키를 넣고 Release로 바꾸세요.
BUILD_CONFIGURATION=Debug
SIXLABORS_LICENSE_KEY=
